[Unit]
Description=JDG Guide bot + Mini App (FastAPI + aiogram)
After=network.target

[Service]
# Своя учётка: в news.db лежат профили и зашифрованные ключи inFakt юзеров,
# а .env хранит FERNET_KEY — процессу из интернета права root ни к чему.
# Каталог /opt/jdg и БД принадлежат jdg, .env и база — 600.
User=jdg
Group=jdg
WorkingDirectory=/opt/jdg
ExecStart=/opt/jdg/venv/bin/uvicorn server:app --host 127.0.0.1 --port 4400
Restart=always
RestartSec=3
EnvironmentFile=/opt/jdg/.env

# Базовая изоляция: писать можно только в свой каталог и /tmp
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/jdg
# Фоновые циклы уходят в потоки (скрейпинг, inFakt) — их не отменить, и без
# лимита остановка ждала полные 90 с, всё это время прод отдавал 502.
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=multi-user.target
