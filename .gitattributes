# Шелл-скрипты едут на Linux-VPS: CRLF там ломает shebang («bad interpreter»).
*.sh text eol=lf
deploy/*.service text eol=lf

# Вендоренные библиотеки не трогаем конвертацией переводов строк
webapp/vendor/** -text

# Справочник PKD едет сжатым: авто-определение бинарности тут полагаться нельзя,
# одна конвертация CRLF — и gzip на VPS не распакуется
*.gz binary
