 "ambiguity_markers": [
  {"id": "turnkey.v1",
   "phrases": ["под ключ"],
   "blocks": ["activity.manufacture_new", "activity.install_or_assemble"],
   "why": "«Под ключ» означает весь цикл, но не говорит, что человек делает сам: производит, только монтирует чужое или организует чужую работу. Уверенный режим здесь опаснее вопроса."}
 ],

 "negation": {
  "window": 3,
  "markers": ["не", "нет", "без"],
  "affirmative_exceptions": ["не только"],
  "clause_breaks": [",", ";", ".", " — ", " - ", " но ", " хотя ", " зато "],
  "why": "Отрицание фиксируем фактом value=false, а не отсутствием признака: явное «не произвожу» сильнее, чем молчание. «Не только собираю, но и делаю» — это подтверждение обеих деятельностей, а не отрицание."
 }
